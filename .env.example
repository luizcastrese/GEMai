# Copie para .env. Todas as variáveis de aplicação têm o prefixo ERP_.
ERP_AMBIENTE=desenvolvimento            # use "producao" em produção (exige segredo forte, desliga /docs)
ERP_DATABASE_URL=sqlite:///./erp.db      # produção: postgresql+psycopg://usuario:senha@host:5432/erp
ERP_SECRET_KEY=                          # 32+ caracteres aleatórios:  python -c "import secrets;print(secrets.token_urlsafe(48))"
ERP_TOKEN_MINUTOS=60
ERP_PERMITIR_CADASTRO_PUBLICO=true       # false = só o administrador cria usuários (recomendado em produção fechada)
ERP_CORS_ORIGENS=                        # vazio = só mesma origem
ERP_MIN_AMOSTRAS_HISTORICO=3             # amostras aprovadas necessárias para o histórico substituir o parâmetro
ERP_USAR_MODELO_IA_NAO_VALIDADO=true     # false = só modelo de tempo validado por gestor vale como tempo planejado

# IA (opcional). Sem chave, o sistema usa o provedor local por regras.
ERP_IA_PROVEDOR=auto                     # auto | heuristica | claude
ERP_ANTHROPIC_API_KEY=
ERP_IA_MODELO=claude-opus-5-5

# docker-compose
POSTGRES_PASSWORD=
FORWARDED_ALLOW_IPS=127.0.0.1
